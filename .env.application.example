# Copy to an ignored .env.application and replace these with absolute host paths.
APPLICATION_PLATFORM=linux/arm64
APPLICATION_PORT=15173

# Existing compatible assets. The complete run must include ratio_80_10_10/train.parquet.
TRUSTWORTHY_RECSYS_RUN_DIR=/absolute/path/to/data/processed/m3_ratio_80_10_10_20261002
TRUSTWORTHY_RECSYS_RETRIEVAL_INPUTS_DIR=/absolute/path/to/data/downloads/two_tower_80_v1/inputs
TRUSTWORTHY_RECSYS_RETRIEVAL_MODEL_DIR=/absolute/path/to/artifacts/retrieval/m4_bundle_weaviate_84366c2
TRUSTWORTHY_RECSYS_RERANKER_MODEL_DIR=/absolute/path/to/artifacts/ranking/lambdarank_v1

# Existing Weaviate identity. Inspect Docker before changing these values.
WEAVIATE_NETWORK=ai-capstone-trustworthy-recsys_default
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_STARTUP_TIMEOUT_SECONDS=180

# Optional artwork credential. It is passed only to the API at runtime.
TMDB_READ_ACCESS_TOKEN=

# Optional research feedback remains off by default.
TRUSTWORTHY_RECSYS_FEEDBACK_MODE=off
TRUSTWORTHY_RECSYS_FEEDBACK_EPSILON=0.1
TRUSTWORTHY_RECSYS_FEEDBACK_TRAFFIC=pilot
