# Environment variables are read from the process environment. Copy this file
# to .env for local development, and never commit real credentials.
TRUSTWORTHY_RECSYS_BACKEND=fixture
TRUSTWORTHY_RECSYS_RUN_DIR=
TRUSTWORTHY_RECSYS_SCENARIO=ratio_80_10_10
TRUSTWORTHY_RECSYS_RETRIEVAL_INPUTS_DIR=
TRUSTWORTHY_RECSYS_RETRIEVAL_MODEL_DIR=
TMDB_READ_ACCESS_TOKEN=

# Movie feedback experiment. Set randomized for the local pilot; off disables it.
TRUSTWORTHY_RECSYS_FEEDBACK_MODE=off
TRUSTWORTHY_RECSYS_FEEDBACK_DB=data/feedback/movie.sqlite3
TRUSTWORTHY_RECSYS_FEEDBACK_EPSILON=0.1
# Use synthetic for automated traffic; fixture mode is always synthetic.
TRUSTWORTHY_RECSYS_FEEDBACK_TRAFFIC=pilot
